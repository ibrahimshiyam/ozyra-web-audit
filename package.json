{
  "name": "ozyra-web-audit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Deterministic controlled-site browser audit with screenshots, axe and Lighthouse; public targets disabled",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js demo",
    "test:browser": "OZYRA_BROWSER_TESTS=1 node --test --test-concurrency=1 test/browser.test.js",
    "controlled": "node src/cli.js controlled"
  },
  "bin": {
    "ozyra-web-audit": "src/cli.js"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "css-tree": "3.2.1",
    "ipaddr.js": "2.5.0",
    "lighthouse": "13.5.0",
    "parse5": "8.0.1",
    "playwright-core": "1.64.1",
    "puppeteer-core": "25.15.0",
    "robots-parser": "3.0.1"
  },
  "devDependencies": {
    "dns-packet": "5.6.1"
  }
}
